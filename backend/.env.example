# =====================================================
# EDM ZCO - Template zmiennych srodowiskowych (backend)
# Skopiuj do .env / .env.dev / .env.spark i uzupelnij.
# NIE commituj plikow .env z prawdziwymi wartosciami!
# =====================================================

# Baza danych PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@HOST:5432/edmdatabase

# Bezpieczenstwo (JWT) - wygeneruj: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS (dozwolone originy, rozdzielone przecinkami; NIE uzywaj * z credentials)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Kierunek [2]: n8n -> backend (callbacki) ---
# Sekret dla wywolan przychodzacych od n8n (/api/webhook/*, /api/chat/sources).
# Wygeneruj: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Ta sama wartosc musi trafic do nodow HTTP Request w n8n jako naglowek
# X-Webhook-Secret. Pozostawienie pustego = brak weryfikacji (tylko dev!).
WEBHOOK_SECRET=

# --- Kierunek [1]: backend -> n8n (triggery workflowow) ---
# Naglowek dolaczany do wywolan webhookow n8n. Musi zgadzac sie z credentialem
# Header Auth podpietym pod nody Webhook (trigger) w workflowach.
# MUSI byc innym sekretem niz WEBHOOK_SECRET.
N8N_AUTH_HEADER=X-N8N-Webhook-Secret
N8N_AUTH_VALUE=

# Poziom logowania aplikacji (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# Storage plikow
STORAGE_PATH=/data/shared_docs

# Uslugi zewnetrzne (Spark)
QDRANT_URL=http://192.168.1.34:6333
# Kolekcja Qdrant, z ktorej backend usuwa wektory przy DELETE pliku
QDRANT_COLLECTION=chi_camp_2026
# N8N_WEBHOOK_URL moze byc nadpisany w ustawieniach aplikacji (tabela settings)
N8N_WEBHOOK_URL=http://192.168.1.34:5678/webhook/document-uploaded
DOCLING_API_URL=http://127.0.0.1:8002
OLLAMA_API_URL=http://192.168.1.34:11434
