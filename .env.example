# ============================================================
# EDM ZCO — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy to .env and set values:
#   cp .env.example .env
# ============================================================

# ---------- NETWORK ----------
# Frontend port (host mapping)
FRONTEND_PORT=3000

# Backend port (host mapping)
BACKEND_PORT=8083

# Backend API URL - for Docker internal communication
# Frontend uses this to connect to backend
NEXT_PUBLIC_API_URL=http://backend:8000

# ---------- DATABASE ----------
DATABASE_URL=postgresql+psycopg2://postgres:tajne_haslo@edm-zco-postgres:5432/edmdatabase

# ---------- SECURITY ----------
SECRET_KEY=change-this-to-random-secure-key

# ---------- EXTERNAL SERVICES ----------
QDRANT_URL=http://192.168.1.34:6333
QDRANT_COLLECTION=chi_camp_2026
N8N_WEBHOOK_URL=http://192.168.1.34:5678/webhook/document-uploaded
DOCLING_API_URL=http://docling:8002
OLLAMA_API_URL=http://192.168.1.34:11434

# ---------- CORS ----------
# Allowed origins for API requests
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------- WEBHOOKI: kierunek [2] (n8n -> backend) ----------
# Sekret chroniacy /api/webhook/* i /api/chat/sources.
# Wygeneruj: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Ta sama wartosc jako naglowek X-Webhook-Secret w nodach HTTP Request w n8n.
WEBHOOK_SECRET=

# ---------- WEBHOOKI: kierunek [1] (backend -> n8n) ----------
# Naglowek dolaczany do wywolan triggerow n8n; musi zgadzac sie z credentialem
# Header Auth na nodach Webhook. MUSI byc innym sekretem niz WEBHOOK_SECRET.
N8N_AUTH_HEADER=X-N8N-Webhook-Secret
N8N_AUTH_VALUE=

# ---------- LOGOWANIE ----------
LOG_LEVEL=INFO
# Szczegolowe logi proxy Next.js (nigdy nie loguje naglowkow ani cial zadan)
PROXY_DEBUG=false

# =====================================================
# UWAGI:
# =====================================================
# 1. Baza danych PostgreSQL na Spark:
#    - Host: edm-zco-postgres (DNS w Docker network)
#    - Port: 5432
#    - User: postgres
#    - Password: tajne_haslo
#    - DB: edmdatabase
#
# 2. Spark services (192.168.1.34):
#    - n8n: http://192.168.1.34:5678
#    - Qdrant: http://192.168.1.34:6333
#    - Ollama: http://192.168.1.34:11434
#    - Docling: http://docling:8002 (docker network)
#
# 3. Frontend (Next.js): http://localhost:3000
# 4. Backend (FastAPI): http://localhost:8083
#    - API docs: http://localhost:8083/docs
#    - Health: http://localhost:8083/api/health
#
# 5. Storage plików: /data (volume mount)
# =====================================================